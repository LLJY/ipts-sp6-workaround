post_install() {
    systemctl daemon-reload
    udevadm control --reload
    printf '%s\n' 'SP6 IPTS workaround installed. Reboot to attach the HID-BPF fix.' \
        'For immediate activation: sudo /usr/lib/ipts-sp6-workaround/recover --force' \
        'This briefly disconnects the touchscreen; it leaves the packaged kernel unchanged.'
}
post_upgrade() { post_install; }
post_remove() {
    systemctl daemon-reload
    udevadm control --reload
    printf '%s\n' 'SP6 IPTS workaround removed. Reboot to detach any loaded HID-BPF correction.'
}
